# Nginx reverse proxy for Home Assistant Ingress → Zählwerk App Space (Next.js).
#
# `${BUILD_OPTIONS_BACKEND_URL}` is substituted by run.sh (via envsubst) at
# start-up; every other `$…` below is a genuine Nginx runtime variable and is
# deliberately left untouched by the restricted envsubst call.
#
# Dieser Proxy leitet weiter — mehr nicht. Er formt keine Sicherheitskopfzeilen
# um: die App kennt ihre eigene Policy, und eine zweite Fassung hier waere eine
# zweite Wahrheit, die beim naechsten Aenderung der ersten still veraltet.

worker_processes  auto;
error_log         /dev/stderr  warn;
pid               /var/run/nginx.pid;

events {
    worker_connections  1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    access_log    /dev/stdout;

    sendfile      on;
    keepalive_timeout  65;

    # Map the Upgrade header so WebSocket/HMR connections are proxied correctly
    # and normal requests get "Connection: close".
    map $http_upgrade $connection_upgrade {
        default  upgrade;
        ''       close;
    }

    server {
        # HA Ingress connects to this port on the add-on (matches ingress_port).
        listen  80  default_server;
        server_name  _;

        # Next.js has no hard upload limit here; keep generous for CSV log imports.
        client_max_body_size  50m;

        location / {
            proxy_pass         ${BUILD_OPTIONS_BACKEND_URL};
            proxy_http_version 1.1;

            # ── WebSocket / Next.js HMR & live features ──
            proxy_set_header  Upgrade     $http_upgrade;
            proxy_set_header  Connection  $connection_upgrade;

            # ── Preserve the original request context ──
            # Next.js/Auth.js run with trustHost=true and rely on these to build
            # correct absolute URLs (callback URLs, redirects) that stay inside
            # the Home Assistant Ingress frame.
            proxy_set_header  Host               $host;
            proxy_set_header  X-Real-IP          $remote_addr;
            proxy_set_header  X-Forwarded-For    $proxy_add_x_forwarded_for;
            proxy_set_header  X-Forwarded-Proto  $scheme;
            proxy_set_header  X-Forwarded-Host   $http_host;

            # Hint the app that it is being served embedded (Ingress iframe) so
            # it can trim duplicate chrome. The app also detects framing itself.
            proxy_set_header  X-HA-Ingress  "true";

            # ── Einbettung: NICHT hier geregelt ──
            #
            # Frueher stand an dieser Stelle die komplette
            # Content-Security-Policy der App ein zweites Mal, mitsamt der
            # Bitte, sie "in sync" zu halten. Genau das ist schiefgegangen: zwei
            # Orte fuer dieselbe Sicherheitsregel, und der hier hat nicht
            # mitbekommen, wenn die App ihre Regel aenderte — ein Proxy, der eine
            # veraltete Policy ueber eine aktuelle legt, schwaecht sie still.
            #
            # Die App entscheidet das jetzt selbst, beim Bauen:
            #   HA_INGRESS=true                  -> frame-ancestors 'self'
            #   FRAME_ANCESTORS="http://ha:8123" -> genau dieser Ursprung
            #
            # Unter Ingress ist HAs Origin die eigene, 'self' passt also. Fuer den
            # panel_iframe-Weg (fester Port, fremder Ursprung) traegt man die
            # HA-Adresse in FRAME_ANCESTORS ein. Beide Wege ohne eine Zeile nginx.
            #
            # Der Ingress-Pfad wird durchgereicht, damit die App ihn kennt —
            # HA setzt ihn, und ohne ihn kann niemand darunter liegende
            # Verweise richtig bilden.
            proxy_set_header  X-Ingress-Path  $http_x_ingress_path;

            # Do NOT rewrite Location/redirect headers — Ingress path routing must
            # stay intact so redirects remain inside the HA frame.
            proxy_redirect  off;

            # Long timeouts so streamed responses / WebSockets aren't cut off.
            proxy_read_timeout  3600s;
            proxy_send_timeout  3600s;
            proxy_buffering     off;
        }
    }
}
