dist/
build/
coverage/
*.log

# Playwright / E2E artifacts.
# NOTE the `**/` prefix: a pattern containing a slash is anchored to this file's
# directory, so a bare `e2e/.data/` would only ever match a top-level `e2e/` —
# never the real `apps/main-portal/e2e/`. That mismatch is how these artifacts
# got committed in the first place.
**/e2e/.data/
**/e2e/.auth/
**/e2e/.report/
**/e2e/.test-results/
**/e2e/.shots/
**/e2e/.shots-results/
**/playwright-report/
**/test-results/

# Local machine-specific settings, not shared with the team
.claude/settings.local.json

# graphify knowledge-graph output. Regenerated from the source tree by
# `/graphify`, several MB per build (graph.json + graph.html), and stale the
# moment anything is committed — a derived artifact, not a source of truth.
graphify-out/
