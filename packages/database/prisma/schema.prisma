// Pinned to the last Prisma 6.x release deliberately: Prisma 7 made driver
// adapters mandatory (no more plain `new PrismaClient()`) and switched to a
// WASM query engine + new config file. None of that buys us anything here,
// so we stay on the simpler, battle-tested classic engine.
generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

// SQLite locally (matches the reference `zaehlwerk` project and needs zero
// setup). For production, point DATABASE_URL at Postgres and change the
// provider below to "postgresql" (Prisma's SQL generation differs slightly
// per provider, so the provider itself isn't swappable at runtime) — then
// rerun `pnpm db:generate`.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Rolle eines Anwendungsbenutzers. ADMIN darf u.a. Benutzer verwalten.
enum Role {
  ADMIN
  USER
}

/// Anwendungsbenutzer für Login + Rollen (siehe apps/main-portal `auth.ts`).
/// Passwörter werden ausschließlich als bcrypt-Hash gespeichert.
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

/// Energieträger / Kategorie eines Zählers.
enum EnergyCategory {
  STROM
  GAS
  WASSER
  PV_ERZEUGUNG
  PV_EINSPEISUNG
  CUSTOM
}

/// Standort, dem Zähler zugeordnet werden können (z.B. Gebäude, Wohnung).
model Location {
  id        String    @id @default(uuid())
  name      String
  address   String?
  note      String?
  createdAt DateTime  @default(now())
  zaehler   Zaehler[]

  @@map("locations")
}

/// Ein Zähler (z.B. "Strom Hauptzähler"). Entspricht `System` im
/// Referenzprojekt: überlebt Zählertausche, die Historie steckt in
/// `Ablesung`, nicht hier.
model Zaehler {
  id         String         @id @default(uuid())
  name       String
  kategorie  EnergyCategory
  einheit    String
  farbe      String         @default("#495a6c")
  icon       String         @default("bolt")
  aktiv      Boolean        @default(true)
  sortIndex  Int            @default(0)
  locationId String?
  location   Location?      @relation(fields: [locationId], references: [id])
  ablesungen Ablesung[]
  tarife     Tarif[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([locationId])
  // Deckt die Standardliste `where aktiv orderBy sortIndex` (listZaehler) ab.
  @@index([aktiv, sortIndex])
  @@map("zaehler")
}

/// Ein Zählerstand / eine Ablesung. Verbrauch wird daraus abgeleitet
/// (Differenz zweier Ablesungen), nicht separat gespeichert — siehe
/// `src/consumption.ts`.
model Ablesung {
  id               String   @id @default(uuid())
  zaehlerId        String
  zaehler          Zaehler  @relation(fields: [zaehlerId], references: [id], onDelete: Cascade)
  datum            DateTime
  wert             Float
  kosten           Float?
  /// Markiert die erste Ablesung nach einem Zählertausch. Der Verbrauch bis
  /// hierhin berechnet sich dann aus `startwertNeu` statt aus der vorherigen
  /// Ablesung (die gehörte zum alten physischen Zähler).
  zaehlerGetauscht Boolean  @default(false)
  startwertNeu     Float?
  notiz            String?
  quelle           String   @default("manual")
  istAbgerechnet   Boolean  @default(false)
  createdAt        DateTime @default(now())

  // Composite deckt die häufigste Query ab (`where zaehlerId orderBy datum`,
  // getZaehlerById/listZaehler) und dient als linkes Präfix auch für reine
  // zaehlerId-Lookups — ein separater [zaehlerId]-Index wäre redundant.
  @@index([zaehlerId, datum])
  // Für die globale "letzte Ablesungen"-Liste (listRecentAblesungen), die
  // über alle Zähler hinweg nach datum sortiert.
  @@index([datum])
  @@map("ablesungen")
}

/// Tarifperiode eines Zählers. Kosten werden daraus berechnet — siehe
/// `src/tariff.ts`. Nach dem Original-Projekt (Za_hler.xlsm, Blatt „Verträge"
/// / „Gas in kWh"): Arbeitspreis netto je Abrechnungseinheit + Grundpreis/Jahr
/// netto, MwSt getrennt.
model Tarif {
  id                  String    @id @default(uuid())
  zaehlerId           String
  zaehler             Zaehler   @relation(fields: [zaehlerId], references: [id], onDelete: Cascade)
  anbieter            String?
  produkt             String?
  gueltigAb           DateTime
  gueltigBis          DateTime?
  /// Arbeitspreis netto in Cent je Abrechnungseinheit (kWh bei Strom/Gas, m³ bei Wasser).
  arbeitspreisCtNetto Float
  /// Grundpreis netto in Euro pro Jahr.
  grundpreisJahrNetto Float     @default(0)
  /// MwSt-Satz in Prozent (Standard 19).
  mwstProzent         Float     @default(19)
  notiz               String?
  createdAt           DateTime  @default(now())

  @@index([zaehlerId, gueltigAb])
  @@map("tarife")
}
