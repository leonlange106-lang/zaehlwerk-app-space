// Pinned to the last Prisma 6.x release deliberately: Prisma 7 made driver
// adapters mandatory (no more plain `new PrismaClient()`) and switched to a
// WASM query engine + new config file. None of that buys us anything here,
// so we stay on the simpler, battle-tested classic engine.
generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

// SQLite locally (matches the reference `zaehlwerk` project and needs zero
// setup). For production, point DATABASE_URL at Postgres and change the
// provider below to "postgresql" (Prisma's SQL generation differs slightly
// per provider, so the provider itself isn't swappable at runtime) — then
// rerun `pnpm db:generate`.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Rolle eines Anwendungsbenutzers. ADMIN darf u.a. Benutzer verwalten.
enum Role {
  ADMIN
  USER
}

/// Anwendungsbenutzer für Login + Rollen (siehe apps/main-portal `auth.ts`).
/// Passwörter werden ausschließlich als bcrypt-Hash gespeichert.
model User {
  id               String     @id @default(uuid())
  email            String     @unique
  passwordHash     String
  name             String?
  role             Role       @default(USER)
  /// TOTP-Secret (Base32), AES-GCM-verschlüsselt gespeichert — nie im Klartext.
  twoFactorSecret  String?
  twoFactorEnabled Boolean    @default(false)
  /// Wenn true, wurde der Account mit einem Temp-Passwort angelegt: der erste
  /// Login gelingt ohne Passwort (nur per E-Mail), danach MUSS sofort ein
  /// eigenes Passwort vergeben werden, bevor die App nutzbar ist. Wird beim
  /// Setzen des Passworts auf false gesetzt.
  mustSetPassword  Boolean    @default(false)
  /// JSON-Array der App-IDs, die dieser Benutzer sehen/nutzen darf (z.B.
  /// ["zaehlwerk"]). Standardmäßig leer — neue Benutzer haben KEINE App-Freigabe
  /// und müssen von einem Admin freigeschaltet werden. Admins sehen stets alle
  /// Apps (rollenbasiert), unabhängig von diesem Feld.
  allowedApps      String     @default("[]")
  apiTokens        ApiToken[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@map("users")
}

/// Persönlicher API-Token (PAT) für Zugriffe ohne Web-Session (Skripte, Smart
/// Home). Der Klartext-Token (`zw_pat_…`) wird nur bei Erstellung angezeigt;
/// gespeichert wird ausschließlich der SHA-256-Hash.
model ApiToken {
  id         String    @id @default(uuid())
  name       String
  tokenHash  String    @unique
  lastUsedAt DateTime?
  expiresAt  DateTime?
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("api_tokens")
}

/// Schlichter Key/Value-Store für Instanz-Einstellungen, die keine eigene
/// Tabelle rechtfertigen (z.B. Backup-Aufbewahrungsfrist, Auto-Backup an/aus,
/// Zeitpunkt des letzten automatischen Backups). Werte werden als String
/// abgelegt und beim Lesen typisiert — siehe `app/lib/settings-actions.ts`.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}

/// Schlankes Audit-Log für Compliance: protokolliert kritische Systemaktionen
/// (System-Update, Admin-/Benutzeränderungen, PAT-Erstellung, Massen-Importe,
/// Backups, DB-Wartung). Bewusst append-only und best-effort — ein Fehler beim
/// Schreiben darf die eigentliche Aktion nie blockieren.
model AuditLog {
  id        String   @id @default(uuid())
  /// Maschinenlesbare Aktion, z.B. "user.create", "token.create", "backup.create".
  action    String
  /// Wer die Aktion ausgelöst hat (E-Mail des Nutzers) oder "system".
  actor     String
  /// Menschlich lesbare Zusammenfassung (z.B. betroffener Benutzer, Dateiname).
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@map("audit_logs")
}

/// Energieträger / Kategorie eines Zählers.
enum EnergyCategory {
  STROM
  GAS
  WASSER
  PV_ERZEUGUNG
  PV_EINSPEISUNG
  CUSTOM
}

/// Standort, dem Zähler zugeordnet werden können (z.B. Gebäude, Wohnung).
model Location {
  id        String    @id @default(uuid())
  name      String
  address   String?
  note      String?
  createdAt DateTime  @default(now())
  zaehler   Zaehler[]

  @@map("locations")
}

/// Ein Zähler (z.B. "Strom Hauptzähler"). Entspricht `System` im
/// Referenzprojekt: überlebt Zählertausche, die Historie steckt in
/// `Ablesung`, nicht hier.
model Zaehler {
  id                  String              @id @default(uuid())
  name                String
  kategorie           EnergyCategory
  einheit             String
  farbe               String              @default("#495a6c")
  icon                String              @default("bolt")
  aktiv               Boolean             @default(true)
  sortIndex           Int                 @default(0)
  /// Erwarteter Ableseabstand in Tagen. **0 = aus**, wie bei den
  /// Aufbewahrungsgrenzen: eine Erinnerung, die niemand bestellt hat, ist eine
  /// Belästigung, und die Glocke verliert ihren Wert, wenn ständig etwas drin
  /// steht. Nur gesetzte Intervalle erzeugen eine Meldung.
  ableseIntervallTage Int                 @default(0)
  /// Stellenzahl des Zaehlwerks, z. B. 6 fuer ein Geraet, das bei 999999
  /// ueberlaeuft. `null` = unbekannt.
  ///
  /// Optional, und das ist die richtige Vorgabe: Aus den Ablesungen allein
  /// laesst sich die Stellenzahl nicht ableiten, und ein falsch geratener
  /// Ueberlauf erfindet Verbrauch, den es nie gab. Ohne Angabe bleibt ein
  /// negatives Delta wie bisher "unplausibel" — sichtbar statt stillschweigend
  /// korrigiert.
  stellen             Int?
  locationId          String?
  location            Location?           @relation(fields: [locationId], references: [id])
  ablesungen          Ablesung[]
  register            MeterRegister[]
  tarife              Tarif[]
  umrechnungsfaktoren Umrechnungsfaktor[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([locationId])
  // Deckt die Standardliste `where aktiv orderBy sortIndex` (listZaehler) ab.
  @@index([aktiv, sortIndex])
  @@map("zaehler")
}

/// Ein Zählerstand / eine Ablesung. Verbrauch wird daraus abgeleitet
/// (Differenz zweier Ablesungen), nicht separat gespeichert — siehe
/// `src/consumption.ts`.
/// Richtung, in die ein Register zählt. Ein Zweirichtungszähler führt beide.
enum RegisterRichtung {
  BEZUG
  EINSPEISUNG
}

/// Ein Zählwerk INNERHALB eines Zählers, identifiziert über seine OBIS-Kennziffer.
///
/// Bis v3 hatte ein Zähler genau einen Wert. Das trägt nicht mehr, sobald eine
/// PV-Anlage einspeist: Der moderne Messeinrichtung führt dann `1.8.0` (Bezug)
/// und `2.8.0` (Einspeisung) gleichzeitig, und beide Reihen sind eigenständig —
/// saldieren würde beide Aussagen zerstören.
///
/// Bewusst als eigene Tabelle statt als zwei Spalten am Zähler: Dieselbe Form
/// deckt den Doppeltarif (`1.8.1`/`1.8.2` für HT/NT) ohne weitere Schemaänderung
/// ab, und ein späteres drittes Register (Erzeugung am Wechselrichter) ist dann
/// eine Zeile, kein Umbau.
model MeterRegister {
  id         String           @id @default(uuid())
  zaehlerId  String
  zaehler    Zaehler          @relation(fields: [zaehlerId], references: [id], onDelete: Cascade)
  /// OBIS-Kennziffer, z. B. "1.8.0" (Bezug), "2.8.0" (Einspeisung).
  obisCode   String
  richtung   RegisterRichtung @default(BEZUG)
  /// HT/NT-Kennzeichen bei Doppeltarif; null = kein Doppeltarif.
  tarif      String?
  einheit    String
  /// Anzeigename, z. B. "Bezug" oder "Einspeisung".
  label      String
  sortIndex  Int              @default(0)
  ablesungen Ablesung[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  /// Eine OBIS-Kennziffer kommt je Zähler genau einmal vor — sonst laufen zwei
  /// Reihen für dasselbe physische Zählwerk nebeneinander her.
  @@unique([zaehlerId, obisCode])
  @@index([zaehlerId, sortIndex])
  @@map("meter_register")
}

model Ablesung {
  id               String              @id @default(uuid())
  zaehlerId        String
  zaehler          Zaehler             @relation(fields: [zaehlerId], references: [id], onDelete: Cascade)
  /// Das Register, zu dem dieser Stand gehört.
  ///
  /// **Optional, nicht verpflichtend** — und das ist eine bewusste Entscheidung,
  /// keine Nachlässigkeit: Ein Rollback überspringt die Migration, danach
  /// schreibt eine ältere Anwendung wieder Ablesungen ohne Register. Eine
  /// `NOT NULL`-Spalte ohne Default würde genau dort jedes INSERT scheitern
  /// lassen. Ein fehlender Bezug wird gelesen als "das Standardregister des
  /// Zählers"; die Migration füllt alle bestehenden Zeilen.
  registerId       String?
  register         MeterRegister?      @relation(fields: [registerId], references: [id], onDelete: SetNull)
  datum            DateTime
  wert             Float
  kosten           Float?
  /// Markiert die erste Ablesung nach einem Zählertausch. Der Verbrauch bis
  /// hierhin berechnet sich dann aus `startwertNeu` statt aus der vorherigen
  /// Ablesung (die gehörte zum alten physischen Zähler).
  zaehlerGetauscht Boolean             @default(false)
  startwertNeu     Float?
  notiz            String?
  quelle           String              @default("manual")
  istAbgerechnet   Boolean             @default(false)
  /// Wann diese Ablesung gelöscht wurde. `null` = vorhanden.
  ///
  /// Soft-Delete statt DELETE, weil ein Zählerstand kein beliebiger Datensatz
  /// ist: Er ist ein Messwert von einem Zeitpunkt, der nicht wiederkommt. Wer
  /// versehentlich die falsche Zeile trifft, kann sie nicht neu ablesen — die
  /// Zahl stünde nur noch auf einem Zettel oder nirgends.
  ///
  /// Optional und ohne Default, wie jede Spalte seit der Rollback-Regel: Eine
  /// ältere Anwendung schreibt nach einem Rollback wieder ohne dieses Feld, und
  /// `null` heißt dort dasselbe wie hier — vorhanden.
  geloeschtAm      DateTime?
  /// Wer gelöscht hat. Freitext, damit die Spur auch dann lesbar bleibt, wenn
  /// das Benutzerkonto später verschwindet.
  geloeschtVon     String?
  createdAt        DateTime            @default(now())
  /// Änderungen an dieser Ablesung, jüngste zuerst.
  aenderungen      AblesungAenderung[]

  // Composite deckt die häufigste Query ab (`where zaehlerId orderBy datum`,
  // getZaehlerById/listZaehler) und dient als linkes Präfix auch für reine
  // zaehlerId-Lookups — ein separater [zaehlerId]-Index wäre redundant.
  @@index([zaehlerId, datum])
  // Für die globale "letzte Ablesungen"-Liste (listRecentAblesungen), die
  // über alle Zähler hinweg nach datum sortiert.
  @@index([datum])
  // Die Reihe EINES Registers, chronologisch — die Abfrage, auf der die
  // Verbrauchsrechnung je Register aufsetzt.
  @@index([registerId, datum])
  // Die Standardabfrage ist jetzt "vorhandene Ablesungen dieses Zaehlers,
  // chronologisch". Ohne diesen Index liefe sie ueber den vollen Bestand und
  // siebte die geloeschten erst danach aus.
  @@index([zaehlerId, geloeschtAm, datum])
  @@map("ablesungen")
}

/// Eine Änderung an einer Ablesung — wer, wann, was vorher galt.
///
/// Beantwortet die eine Frage, die später gestellt wird: „Warum sieht der März
/// anders aus als in Erinnerung?" Bislang ließ sich das nicht beantworten — eine
/// korrigierte Ablesung sah aus wie eine, die schon immer so dastand.
///
/// Nur der VORHERIGE Zustand wird festgehalten, nicht der neue: Der neue steht
/// in der Ablesung selbst, und ihn zu doppeln hiesse, zwei Wahrheiten zu
/// pflegen, von denen eine driftet.
model AblesungAenderung {
  id           String    @id @default(uuid())
  ablesungId   String
  ablesung     Ablesung  @relation(fields: [ablesungId], references: [id], onDelete: Cascade)
  /// Was geschah: "aktualisiert", "geloescht", "wiederhergestellt".
  aktion       String
  /// Wer es tat. Freitext, s. `Ablesung.geloeschtVon`.
  akteur       String
  /// Der Wert VOR der Änderung.
  vorherWert   Float?
  vorherDatum  DateTime?
  vorherKosten Float?
  vorherNotiz  String?
  createdAt    DateTime  @default(now())

  @@index([ablesungId, createdAt])
  @@map("ablesung_aenderungen")
}

/// Tarifperiode eines Zählers. Kosten werden daraus berechnet — siehe
/// `src/tariff.ts`. Nach dem Original-Projekt (Za_hler.xlsm, Blatt „Verträge"
/// / „Gas in kWh"): Arbeitspreis netto je Abrechnungseinheit + Grundpreis/Jahr
/// netto, MwSt getrennt.
model Tarif {
  id                  String    @id @default(uuid())
  zaehlerId           String
  zaehler             Zaehler   @relation(fields: [zaehlerId], references: [id], onDelete: Cascade)
  anbieter            String?
  produkt             String?
  gueltigAb           DateTime
  gueltigBis          DateTime?
  /// Arbeitspreis netto in Cent je Abrechnungseinheit (kWh bei Strom/Gas, m³ bei Wasser).
  arbeitspreisCtNetto Float
  /// Grundpreis netto in Euro pro Jahr.
  grundpreisJahrNetto Float     @default(0)
  /// MwSt-Satz in Prozent (Standard 19).
  mwstProzent         Float     @default(19)
  notiz               String?
  createdAt           DateTime  @default(now())

  @@index([zaehlerId, gueltigAb])
  @@map("tarife")
}

/// Persistierte MGflasher-Datenlogs des Log-Analyzers. Ersetzt die frühere rein
/// browserlokale History: hochgeladene Logs bleiben serverseitig gespeichert,
/// tragen den ausgewerteten Pull-Status (verified/partial/invalid) und
/// benutzerdefinierte Tags (real gefahrene Oktanzahl u.a.).
model LogFile {
  id             String    @id @default(uuid())
  name           String
  /// Quelle: "upload" oder "remote".
  source         String    @default("upload")
  sourceUrl      String?
  /// Roh-CSV; beim Öffnen erneut geparst (kein Verlust, kompakte Speicherung).
  csv            String
  rowCount       Int       @default(0)
  /// Denormalisierte Header-Metadaten für die Übersicht.
  vin            String?
  vehicle        String?
  mapVersion     String?
  software       String?
  loggedAt       String?
  /// Automatisch bewerteter Pull-Status: "verified" | "partial" | "invalid".
  status         String    @default("invalid")
  /// Hardware-Health aus den Safety-Alerts: "safe" | "caution" | "danger".
  health         String    @default("safe")
  /// Fingerprint der Bewertungslogik+Grenzwerte, mit denen `status`/`health`
  /// zuletzt berechnet wurden (siehe `lib/evaluation-version.ts`). Stimmt er mit
  /// der aktuellen Version überein, gelten die Spalten als gültiger Cache und
  /// die Übersicht muss das Roh-CSV nicht erneut parsen; sonst wird der Log beim
  /// nächsten Lesen neu bewertet und die Spalten aktualisiert. NULL = unbewertet
  /// (z.B. vor Einführung der Spalte) und damit immer stale.
  evalVersion    String?
  /// SHA-256 des Roh-CSV (hex) — zur Deduplizierung automatischer Importe
  /// (Ingestion-API / Watch-Folder). Manuelle Uploads setzen ihn ebenfalls.
  contentHash    String?
  /// Freitext-Notiz aus dem Ingestion-Request (optional).
  notes          String?
  /// Aus dem Dateinamen geparster Fahr-Zeitpunkt (für chronologische Sortierung).
  recordedAt     DateTime?
  /// Frei vergebene Bezeichnung ("Stage 2 Referenzlauf"). Unterscheidet sich
  /// bewusst von `name`, das der Dateiname bleibt: NULL heißt „nie benannt".
  /// Nur benannte Logs erscheinen im Navigationsmenü — ein Menü mit jedem
  /// automatisch importierten Dateinamen wäre kein Menü mehr.
  label          String?
  /// Real gefahrene Oktanzahl / Kraftstoff (frei, z.B. "100 RON", "E85").
  octane         String?
  /// Weitere frei gesetzte Tags, kommagetrennt.
  tags           String    @default("")
  /// Das Fahrzeug, gegen das dieser Log bewertet wurde. NULL = vor Einführung
  /// der Fahrzeug-Entität importiert (oder es existiert noch keins) — dann gilt
  /// die Default-Spec, genau wie bisher. Ohne diese Referenz ist ein Bericht
  /// nicht reproduzierbar: das aktive Profil kann sich seit der Bewertung
  /// geändert haben.
  /// Heißt `vehicleProfile`, nicht `vehicle`: `vehicle` ist bereits die
  /// Freitext-Kopfzeile aus dem CSV ("Vehicle: …"). Das hier ist das gepflegte
  /// Profil, gegen das bewertet wurde — zwei verschiedene Dinge, die sich einen
  /// Namen zu teilen hätten, wäre eine Verwechslung mit Ansage.
  vehicleId      String?
  vehicleProfile Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())

  @@index([recordedAt])
  @@index([createdAt])
  @@index([contentHash])
  @@index([vehicleId])
  @@map("log_files")
}

/// API-Key für die automatisierte Log-Ingestion (Watch-Folder, Home Assistant,
/// cURL, Sync-Skripte). Wie bei den PATs wird ausschließlich der SHA-256-Hash
/// gespeichert; der Klartext (`zw_ing_…`) wird nur einmalig bei Erstellung
/// angezeigt. Keys sind instanzweit (nicht an einen Benutzer gebunden) und
/// werden von Admins verwaltet.
model IngestionKey {
  id         String    @id @default(uuid())
  name       String
  keyHash    String    @unique
  lastUsedAt DateTime?
  expiresAt  DateTime?
  /// Widerrufen — bleibt als Audit-Spur bestehen, wird aber nicht mehr akzeptiert.
  revoked    Boolean   @default(false)
  createdAt  DateTime  @default(now())

  @@map("ingestion_keys")
}

/// Ein benanntes Fahrzeug — die Ablösung der zwei globalen localStorage-Profile.
///
/// Vorher hielten `spec-store.ts` und `dyno-store.ts` je **genau ein** Profil im
/// Browser. Wer zwei Autos loggt, überschrieb sich damit selbst, und ein Bericht
/// war nicht reproduzierbar: das Profil, gegen das er bewertet wurde, konnte
/// inzwischen ein anderes sein. Ein Fahrzeug ist deshalb ein Datensatz, kein
/// Konstanten-Eintrag und kein Browser-Zustand.
///
/// **Alle Spalten sind optional oder haben einen Default.** Das ist keine
/// Bequemlichkeit: Ein Rollback überspringt die Migration bewusst (ein älteres
/// Schema würde `prisma db push` dazu bringen, Spalten zu löschen), der alte
/// Client läuft danach also gegen das neuere Schema weiter. Eine `NOT NULL`-Spalte
/// ohne Default ist genau der Fall, den ein Rollback nicht überlebt.
model Vehicle {
  id     String  @id @default(uuid())
  /// Frei vergeben ("E92 335i, Sommerreifen"). Der Name, unter dem das Fahrzeug
  /// ausgewählt wird — deshalb Pflicht, aber ohne Eindeutigkeitszwang: zwei
  /// gleich benannte Autos sind das Problem des Besitzers, nicht der Datenbank.
  name   String
  /// Genau eines ist aktiv. Als Flag statt als Setting-Zeile, damit „welches
  /// Fahrzeug ist aktiv" nicht an zwei Orten stehen kann.
  active Boolean @default(false)

  // --- Fahrzeug-Spec (Bewertungsgrundlage des Analyzers) -------------------
  /// Katalog-Ids; NULL heißt „nicht aus dem Katalog gewählt".
  brand        String?
  series       String?
  vehicleModel String?
  engineCode   String  @default("n54")
  transmission String  @default("manual")
  catType      String  @default("oem")
  fuel         String  @default("ron98")
  turbo        String  @default("stock")
  hpfp         String  @default("oem")
  stage        String  @default("stage1")

  /// Benutzereigene Grenzwerte als JSON-Teilmenge von `SpecLimits`. Leeres
  /// Objekt = alles abgeleitet. Nur die überschriebenen Schlüssel stehen drin,
  /// damit eine Änderung an den abgeleiteten Tabellen weiterhin durchschlägt —
  /// wer einen Wert nicht angefasst hat, bekommt weiter den gepflegten.
  limitOverrides String @default("{}")

  /// Fahrdynamik-Profil des virtuellen Prüfstands als JSON (`DynoProfile`).
  /// NULL = noch keins hinterlegt, dann greift die Ableitung aus der Plattform.
  dynoProfile String?

  /// Woher die Prüfstandswerte stammen. Ein fremdes Profil ist die Schätzung
  /// eines Fremden — der Prüfstand darf nicht so tun, als sei sie gemessen.
  /// "own" | "preset" | "imported".
  profileOrigin String @default("own")

  logs      LogFile[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([active])
  @@map("vehicles")
}

/// Brennwert und Zustandszahl fuer EINEN Zeitraum.
///
/// Gas wird in m3 gemessen und in kWh abgerechnet:
/// `kWh = m3 x Brennwert x Zustandszahl`. Beide Zahlen stehen auf jeder
/// Jahresrechnung und aendern sich — der Brennwert sogar monatlich.
///
/// Bis ZW-02 rechnete Zaehlwerk mit zwei festen Werten von 2021. Je weiter das
/// zurueckliegt, desto weiter liegt die Kostenrechnung daneben, und an einer
/// Gasrechnung ist das kein Rundungsfehler, sondern zweistellige Prozente.
///
/// Dieselbe Struktur wie `Tarif` — bewusst, denn es ist dieselbe Frage: "welcher
/// Wert galt wann". Ein zweites Muster dafuer waere ein zweites zum Pflegen.
model Umrechnungsfaktor {
  id           String    @id @default(uuid())
  zaehlerId    String
  zaehler      Zaehler   @relation(fields: [zaehlerId], references: [id], onDelete: Cascade)
  gueltigAb    DateTime
  /// `null` = bis auf Weiteres. EINSCHLIESSLICH, wie bei `Tarif`.
  gueltigBis   DateTime?
  /// kWh je m3.
  brennwert    Float
  zustandszahl Float
  /// Woher der Wert stammt, z. B. "Jahresrechnung 2026".
  quelle       String?
  notiz        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([zaehlerId, gueltigAb])
  @@map("umrechnungsfaktor")
}
